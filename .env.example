# Server-side Gemini configuration (NEVER prefix with NEXT_PUBLIC_).
# - Not required to run the built-in "Try sample episode" flow or mock mode.
# - Required for live WP-009 Gemini structured script generation.
# - Primary default: gemini-3.8-flash (explicit override: gemini-4-hydrogen).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
KURO_GENERATION_MODE=
# Server-side sequential TTS request pacing in ms (allowed: 1000-5000; never NEXT_PUBLIC_*).
KURO_TTS_REQUEST_INTERVAL_MS=1500
